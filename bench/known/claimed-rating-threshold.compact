// expect: MS037
// source: a public dApp (report pending)
// note: minimal reproduction. "Prove your rating is at least the threshold", where the rating comes from a witness and the threshold is a parameter.
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger ratingSum: Counter;
export ledger sequence: Counter;
witness reportedScore(): Uint<16>;

export circuit proveScoreAbove(threshold: Uint<16>): Uint<16> {
  const reportedScore = reportedScore();
  assert(reportedScore >= threshold, "score too low");
  sequence.increment(1);
  return disclose(threshold);
}
