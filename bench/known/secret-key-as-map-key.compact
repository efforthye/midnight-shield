// source: pending (public project; linked here once the maintainers have been told)
// note: minimal reproduction. The raw secret key is the public key of the balances map.
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger balances: Map<Bytes<32>, Uint<64>>;
witness localSecretKey(): Bytes<32>;

export circuit deposit(amount: Uint<64>): [] {
  assert(amount > 0, "Deposit amount must be positive");
  const caller = disclose(localSecretKey());
  balances.insert(caller, disclose(amount));
}
