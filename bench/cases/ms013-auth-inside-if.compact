// expect: MS013
// note: the identity check only runs on one branch, so the Boolean is anyone's on the other
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger attesterCommit: Bytes<32>;
export ledger released: Boolean;
witness attesterSecret(): Bytes<32>;
witness deliveryOk(): Boolean;
export circuit attest(strict: Boolean): [] {
  if (disclose(strict)) {
    assert(persistentHash<Vector<2, Bytes<32>>>([pad(32, "f:att:"), attesterSecret()]) == attesterCommit, "not the attester");
  }
  assert(deliveryOk(), "condition not met");
  released = true;
}
