// expect: none
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger balances: Map<Bytes<32>, Uint<64>>;
witness localSecretKey(): Bytes<32>;
export circuit deposit(a: Uint<64>): [] {
  const caller = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:id:"), localSecretKey()]));
  balances.insert(caller, disclose(a));
}
