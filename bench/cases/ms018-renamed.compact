// expect: MS018
// note: set with a neutral name and no membership check (known limit)
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger seen: Set<Bytes<32>>;
witness secretKey(): Bytes<32>;
export circuit spend(): [] { seen.insert(disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:n:"), secretKey()]))); }
