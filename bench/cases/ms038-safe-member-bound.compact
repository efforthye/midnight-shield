// expect: none
// note: the secret is bound to a registered leaf, so it is fixed
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger members: MerkleTree<10, Bytes<32>>;
export ledger voted: Set<Bytes<32>>;
export ledger yes: Counter;
witness voterSecret(): Bytes<32>;
witness voterPath(leaf: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
export circuit vote(): [] {
  const sk = voterSecret();
  const leaf = persistentHash<Vector<2, Bytes<32>>>([pad(32, "m:leaf:"), sk]);
  const path = voterPath(leaf);
  assert(path.leaf == leaf, "path is not yours");
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "not a voter");
  const nul = persistentHash<Vector<2, Bytes<32>>>([pad(32, "m:nul:"), sk]);
  assert(!voted.member(disclose(nul)), "already voted");
  voted.insert(disclose(nul));
  yes.increment(1);
}
