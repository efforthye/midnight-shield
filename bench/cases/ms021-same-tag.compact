// expect: MS021
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger voters: MerkleTree<10, Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;
witness secretKey(): Bytes<32>;
export circuit join(): [] { voters.insert(disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:voter:"), secretKey()]))); }
export circuit vote(): [] {
  const n = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:voter:"), secretKey()]));
  assert(!nullifiers.member(n), "voted");
  nullifiers.insert(n);
}
