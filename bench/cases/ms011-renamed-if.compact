// expect: MS011
// note: unusual name, but another circuit uses it to decide who may act
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger boss: Bytes<32>;
export ledger n: Counter;
witness secretKey(): Bytes<32>;
export circuit setBoss(k: Bytes<32>): [] { boss = disclose(k); }
export circuit reset(): [] {
  if (disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:boss:"), secretKey()]) == boss)) {
    n.resetToDefault();
  }
}
