// expect: MS003
// note: 16-bit PIN, tag added (tag does not add entropy)
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger h: Bytes<32>;
witness pin(): Uint<16>;
export circuit commitPin(): [] {
  h = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:pin:"), pin() as Field as Bytes<32>]));
}
