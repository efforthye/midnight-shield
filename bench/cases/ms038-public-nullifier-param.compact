// expect: MS038
// note: the nullifier parameter is tied to a secret that nothing else pins
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger root: Bytes<32>;
export ledger claimed: Set<Bytes<32>>;
export ledger paid: Counter;
witness claimSecret(): Bytes<32>;
export circuit claim(nul: Bytes<32>): [] {
  assert(!claimed.member(disclose(nul)), "already claimed");
  assert(persistentHash<Vector<3, Bytes<32>>>([pad(32, "l:nul:"), claimSecret(), root]) == nul, "bad nullifier");
  claimed.insert(disclose(nul));
  paid.increment(1);
}
