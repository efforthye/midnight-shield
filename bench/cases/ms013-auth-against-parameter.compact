// expect: MS013
// note: the hash is compared with a parameter the same prover picks: that proves nothing
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger released: Boolean;
witness attesterSecret(): Bytes<32>;
witness deliveryOk(): Boolean;
export circuit attest(expected: Bytes<32>): [] {
  assert(persistentHash<Vector<2, Bytes<32>>>([pad(32, "g:att:"), attesterSecret()]) == disclose(expected), "not the attester");
  assert(deliveryOk(), "condition not met");
  released = true;
}
