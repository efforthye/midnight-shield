// expect: MS015
// note: the payee proof is declared but never checked, so any secret can claim (reported as medium)
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger payoutRoot: Bytes<32>;
export ledger claimed: Set<Bytes<32>>;
witness secretKey(): Bytes<32>;
witness payoutProof(): Vector<4, Bytes<32>>;
export circuit claim(nul: Bytes<32>): [] {
  assert(!claimed.member(disclose(nul)), "already claimed");
  assert(persistentHash<Vector<3, Bytes<32>>>([pad(32, "j:nul:"), secretKey(), payoutRoot]) == nul, "bad nullifier");
  claimed.insert(disclose(nul));
}
