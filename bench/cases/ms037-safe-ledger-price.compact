// expect: none
// note: the price is tied to the ledger by another check
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger oraclePrice: Uint<64>;
export ledger debt: Uint<128>;
witness price(): Uint<64>;
export circuit borrow(amount: Uint<64>, collateral: Uint<64>): [] {
  const p = price();
  assert(p == oraclePrice, "stale price");
  assert(disclose(collateral) * p >= disclose(amount), "undercollateralized");
  debt = disclose(amount);
}
