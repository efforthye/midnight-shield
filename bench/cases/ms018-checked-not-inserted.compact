// expect: MS018
// note: nullifier checked but never recorded
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger used: Set<Bytes<32>>;
export ledger n: Counter;
witness secretKey(): Bytes<32>;
export circuit claim(): [] {
  const x = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:n:"), secretKey()]));
  assert(!used.member(x), "used");
  n.increment(1);
}
