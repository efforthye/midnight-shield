// expect: none
// note: low-entropy value mixed with a 256-bit secret
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger h: Bytes<32>;
witness secretKey(): Bytes<32>;
witness myAge(): Uint<8>;
export circuit prove(): [] {
  h = disclose(persistentHash<Vector<3, Bytes<32>>>([pad(32, "b:age:"), secretKey(), myAge() as Field as Bytes<32>]));
}
