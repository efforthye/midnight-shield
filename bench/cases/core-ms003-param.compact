// expect: MS003, MS005
// note: circuit parameters are private inputs in Compact, so an 8-bit parameter hashed and published can be brute-forced
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger h: Bytes<32>;
export circuit tagRound(round: Uint<8>): [] {
  h = disclose(persistentHash<Uint<8>>(round));
}
