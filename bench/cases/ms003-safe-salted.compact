// expect: none
// note: low-entropy vote mixed with a 32-byte secret
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger h: Bytes<32>;
witness myVote(): Boolean;
witness secretKey(): Bytes<32>;
export circuit vote(): [] {
  h = disclose(persistentHash<Vector<3, Bytes<32>>>([pad(32, "b:vote:"), secretKey(), myVote() ? pad(32, "y") : pad(32, "n")]));
}
