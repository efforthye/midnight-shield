// expect: MS004
// note: randomness derived from public state
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger c: Bytes<32>;
export ledger counter: Counter;
witness amount(): Uint<64>;
export circuit commit(): [] {
  c = disclose(persistentCommit<Uint<64>>(amount(), persistentHash<Uint<64>>(counter.read())));
}
