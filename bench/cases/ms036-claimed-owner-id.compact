// expect: MS036
// note: MeshJS staking: anyone reads ownerId and passes it
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger ownerId: Uint<32>;
export ledger rate: Uint<64>;
export circuit setRate(callerId: Uint<32>, r: Uint<64>): [] {
  assert(ownerId == disclose(callerId), "only the owner");
  rate = disclose(r);
}
