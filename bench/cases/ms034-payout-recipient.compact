// expect: MS034, MS019
// note: anyone sets where payouts go
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger beneficiary: UserAddress;
export circuit setBeneficiary(b: UserAddress): [] { beneficiary = disclose(b); }
export circuit payout(a: Uint<128>): [] {
  sendUnshielded(default<Bytes<32>>, disclose(a), right<ContractAddress, UserAddress>(beneficiary));
}
