// expect: none
// note: a witness used as an account key is an identifier, not key material
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger amounts: Map<Bytes<32>, Uint<128>>;
witness caller(): Bytes<32>;
export circuit deposit(amount: Uint<128>): [] {
  const user = disclose(caller());
  amounts.insert(user, disclose(amount));
}
