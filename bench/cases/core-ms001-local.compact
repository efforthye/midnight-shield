// expect: MS001
// note: ownPublicKey() through a local
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger owner: ZswapCoinPublicKey;
constructor() { owner = ownPublicKey(); }
export circuit withdraw(): [] {
  const me = ownPublicKey();
  assert(me == owner, "not the owner");
}
