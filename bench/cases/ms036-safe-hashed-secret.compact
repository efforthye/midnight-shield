// expect: none
// note: parameters are private inputs, so a hashed preimage is a secret
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger ownerHash: Bytes<32>;
export ledger rate: Uint<64>;
export circuit setRate(password: Bytes<32>, r: Uint<64>): [] {
  assert(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:owner:"), password]) == ownerHash, "only the owner");
  rate = disclose(r);
}
