// expect: MS038
// note: nothing ties the secret to a voter roll: a new secret is a new vote
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger voted: Set<Bytes<32>>;
export ledger yes: Counter;
witness voterSecret(): Bytes<32>;
export circuit vote(): [] {
  const nul = persistentHash<Vector<2, Bytes<32>>>([pad(32, "k:nul:"), voterSecret()]);
  assert(!voted.member(disclose(nul)), "already voted");
  voted.insert(disclose(nul));
  yes.increment(1);
}
