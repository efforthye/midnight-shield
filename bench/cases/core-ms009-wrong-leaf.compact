// expect: MS009
// note: leaf compared with a caller-chosen parameter, not a value derived from a secret
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

export ledger members: MerkleTree<10, Bytes<32>>;
export ledger counter: Counter;
witness secretKey(): Bytes<32>;
witness path(): MerkleTreePath<10, Bytes<32>>;
export circuit leaf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:leaf:"), sk]);
}
export ledger used: Set<Bytes<32>>;
export circuit act(x: Bytes<32>): [] {
  const p = path();
  assert(disclose(p.leaf == x), "bad leaf");
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(p))), "not a member");
  const n = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "b:n:"), secretKey()]));
  assert(!used.member(n), "used");
  used.insert(n);
}
