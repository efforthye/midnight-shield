// expect: MS019
pragma language_version >= 0.28.0;
import CompactStandardLibrary;

circuit doPay(a: Uint<64>, to: UserAddress): [] { sendUnshielded(default<Bytes<32>>, disclose(a) as Uint<128>, right<ContractAddress, UserAddress>(disclose(to))); }
export circuit pay(a: Uint<64>, to: UserAddress): [] { doPay(a, to); }
