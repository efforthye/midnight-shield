pragma language_version >= 0.28.0;
import CompactStandardLibrary;

// The same features written safely. Midnight Shield reports nothing here.

export ledger ownerId: Bytes<32>;
export ledger committed: Bytes<32>;
export ledger balance: Uint<64>;
export ledger members: MerkleTree<10, Bytes<32>>;
export ledger claimed: Set<Bytes<32>>;
export ledger claims: Counter;

witness secretKey(): Bytes<32>;
witness randomness(): Bytes<32>;
witness myBalance(): Uint<64>;
witness memberPath(): MerkleTreePath<10, Bytes<32>>;

circuit deriveId(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:owner:"), sk]);
}

constructor() {
  ownerId = disclose(deriveId(secretKey()));
}

// Authorize by proving knowledge of the secret behind the stored hash.
export circuit withdraw(): [] {
  assert(deriveId(secretKey()) == ownerId, "not the owner");
}

// Only the current owner can hand ownership to someone else.
export circuit transferOwnership(newOwnerId: Bytes<32>): [] {
  assert(deriveId(secretKey()) == ownerId, "not the owner");
  ownerId = disclose(newOwnerId);
}

// Fresh 32-byte randomness from a witness hides the amount.
export circuit commitAmount(amount: Uint<64>): [] {
  committed = persistentCommit<Uint<64>>(amount, randomness());
}

// The witness value is checked before it becomes public.
export circuit syncBalance(): [] {
  const b = myBalance();
  assert(b <= 1000000, "balance out of range");
  balance = disclose(b);
}

circuit memberLeaf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:member:"), sk]);
}

// Anonymous membership done right: the path is tied to the caller's secret,
// and a nullifier stops the same member from claiming twice.
export circuit claim(): [] {
  const sk = secretKey();
  const path = memberPath();
  assert(disclose(path.leaf == memberLeaf(sk)), "not your path");
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "not a member");
  const n = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:claim:"), sk]));
  assert(!claimed.member(n), "already claimed");
  claimed.insert(n);
  claims.increment(1);
}
