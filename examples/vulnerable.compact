pragma language_version >= 0.28.0;
import CompactStandardLibrary;

// A deliberately vulnerable contract that triggers every Midnight Shield rule.
// Run: npx midnight-shield examples/

export ledger owner: ZswapCoinPublicKey;
export ledger ballots: Set<Bytes<32>>;
export ledger balance: Uint<64>;
export ledger publicKey: Bytes<32>;
export ledger salt: Bytes<32>;
export ledger committed: Bytes<32>;
export ledger recoveryKey: Bytes<32>;
export ledger members: MerkleTree<10, Bytes<32>>;
export ledger claims: Counter;
export ledger claimed: Set<Bytes<32>>;
export ledger posts: Set<Bytes<32>>;
export ledger reactions: Set<Bytes<32>>;
export ledger cachedId: Field;
export ledger sealedBid: Bytes<32>;
export ledger revealedSalt: Bytes<32>;
export ledger spentNotes: Set<Bytes<32>>;
export ledger voters: MerkleTree<10, Bytes<32>>;
export ledger voteNullifiers: Set<Bytes<32>>;
export ledger choiceCommitment: Bytes<32>;
export ledger round: Uint<32>;
export ledger phase: Uint<8>;
export ledger reserve: Field;
export ledger price: Uint<64>;
export ledger ownerHash: Bytes<32>;
export ledger fee: Uint<64>;
export ledger adminId: Uint<32>;
export ledger limit: Uint<64>;
export ledger proofs: Counter;

witness secretKey(): Bytes<32>;
witness myChoice(): Uint<8>;
witness myBalance(): Uint<64>;
witness memberPath(): MerkleTreePath<10, Bytes<32>>;
witness isAdmin(): Boolean;
witness bidRandomness(): Bytes<32>;
witness reportedScore(): Uint<16>;

// MS001: ownPublicKey() is chosen by the prover, so this check authorizes anyone.
export circuit withdraw(): [] {
  assert(ownPublicKey() == owner, "not the owner");
}

// MS011: owner is what withdraw() checks, but anyone can call this and replace it.
export circuit setOwner(newOwner: ZswapCoinPublicKey): [] {
  owner = disclose(newOwner);
}

// MS003: a choice from 0-255 has 8 bits of entropy; publishing its hash reveals it.
export circuit castVote(): [] {
  const h = persistentHash<Vector<2, Bytes<32>>>([pad(32, "vote:"), myChoice() as Field as Bytes<32>]);
  ballots.insert(disclose(h));
}

// MS002: the prover can report any balance; nothing checks it.
export circuit syncBalance(): [] {
  balance = disclose(myBalance());
}

// MS005: no domain tag, so this key is linkable with other hashes of the same secret.
export circuit register(): [] {
  publicKey = disclose(persistentHash<Bytes<32>>(secretKey()));
}

// MS004: the commitment randomness is public ledger state.
export circuit commitAmount(amount: Uint<64>): [] {
  committed = persistentCommit<Uint<64>>(amount, salt);
}

// MS007: the raw secret key is published.
export circuit backupKey(): [] {
  recoveryKey = disclose(secretKey());
}

circuit memberLeaf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:member:"), sk]);
}

// MS008: the member proves who they are, but can claim again and again (no nullifier).
export circuit claim(): [] {
  const path = memberPath();
  assert(disclose(path.leaf == memberLeaf(secretKey())), "not your path");
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "not a member");
  claims.increment(1);
}

// MS009: the path is never tied to the caller, so anyone can submit a member's public path.
export circuit claimOnce(): [] {
  const path = memberPath();
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "not a member");
  const n = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:claim:"), secretKey()]));
  assert(!claimed.member(n), "already claimed");
  claimed.insert(n);
}

circuit memberTag(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:tag:"), sk]);
}

// MS010: members act anonymously, but both circuits publish the same tag,
// so all of one member's posts and reactions can be linked together.
export circuit post(): [] {
  const sk = secretKey();
  const path = memberPath();
  assert(disclose(path.leaf == memberLeaf(sk)), "not your path");
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "not a member");
  const tag = disclose(memberTag(sk));
  assert(!posts.member(tag), "already posted");
  posts.insert(tag);
}

export circuit react(): [] {
  const sk = secretKey();
  const path = memberPath();
  assert(disclose(path.leaf == memberLeaf(sk)), "not your path");
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "not a member");
  const tag = disclose(memberTag(sk));
  assert(!reactions.member(tag), "already reacted");
  reactions.insert(tag);
}

// MS012: transient hashes may change in a future upgrade, so this stored value can stop matching.
export circuit cacheId(): [] {
  cachedId = disclose(transientHash<Vector<2, Bytes<32>>>([pad(32, "example:cache:"), secretKey()]));
}

// MS013: isAdmin() is answered by the prover, so anyone can pass this check.
export circuit adminReset(): [] {
  assert(disclose(isAdmin()), "not an admin");
  claims.resetToDefault();
}

// MS014: the bid is committed, but its randomness is published too, so anyone can open it.
export circuit placeBid(amount: Uint<64>): [] {
  sealedBid = disclose(persistentCommit<Uint<64>>(amount, bidRandomness()));
}

export circuit publishSalt(): [] {
  revealedSalt = disclose(bidRandomness());
}

// MS016: not exported and never called.
circuit oldHelper(x: Field): Field {
  return x;
}

// MS017: an unsigned amount is always >= 0, so this assert checks nothing.
export circuit checkAmount(amount: Uint<64>): [] {
  assert(disclose(amount) >= 0, "negative amount");
}

// MS018: no check that the note was not spent before, so it can be spent again.
export circuit spend(): [] {
  spentNotes.insert(disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:spent:"), secretKey()])));
}

// MS019: anyone can call this and send the contract's tokens anywhere.
export circuit payout(amount: Uint<64>, to: UserAddress): [] {
  sendUnshielded(default<Bytes<32>>, disclose(amount) as Uint<128>, right<ContractAddress, UserAddress>(disclose(to)));
}

// MS020: anyone can mint any amount.
export circuit mint(amount: Uint<64>, to: UserAddress): [] {
  mintUnshieldedToken(pad(32, "example:token:"), disclose(amount), right<ContractAddress, UserAddress>(disclose(to)));
}

// MS021: the nullifier is the same hash as the voter's leaf, so a vote reveals the voter.
export circuit joinVoters(): [] {
  voters.insert(disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:voter:"), secretKey()])));
}

export circuit voteAnonymously(): [] {
  const n = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:voter:"), secretKey()]));
  assert(!voteNullifiers.member(n), "already voted");
  voteNullifiers.insert(n);
}

// MS022: the parameter hides the ledger field 'balance'.
export circuit deposit(balance: Uint<64>): [] {
  assert(disclose(balance) > 0, "empty deposit");
}

// MS023: the secret key is the commitment randomness; opening the commitment reveals it.
export circuit commitChoice(): [] {
  choiceCommitment = disclose(persistentCommit<Uint<8>>(myChoice(), secretKey()));
}

// MS024: the condition is a constant, so the check below never runs.
export circuit closeRound(): [] {
  if (false) {
    assert(round > 0, "no round");
  }
  round = (round + 1) as Uint<32>;
}

// MS025: 'phase' is written twice; the first write has no effect.
export circuit advance(): [] {
  phase = 1;
  phase = 2;
}

// MS026: this parameter hides the standard-library persistentHash().
export circuit echo(persistentHash: Bytes<32>): Bytes<32> {
  return disclose(persistentHash);
}

// MS027: the result of the membership check is thrown away.
export circuit vote2(): [] {
  const n = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:ballot2:"), secretKey()]));
  ballots.member(n);
  ballots.insert(n);
}

// MS028: tokens come in, but no circuit can send them out.
// (The contract does send in payout(), so MS028 is shown in examples/locked.compact.)

// MS029: a comparison with no assert around it.
export circuit checkRound(r: Uint<32>): [] {
  disclose(r) == round;
}

// MS031: Field arithmetic wraps around instead of failing.
export circuit withdrawReserve(amount: Field): [] {
  reserve = reserve - disclose(amount);
}

// MS032: computed and never used.
export circuit audit(): [] {
  const expected = persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:audit:"), pad(32, "x")]);
  assert(round > 0, "no round");
}

// MS034: anyone can set the price, and borrowAgainst() trusts it.
export circuit setPrice(p: Uint<64>): [] {
  price = disclose(p);
}

export circuit borrowAgainst(collateral: Uint<64>, amount: Uint<64>): [] {
  assert(disclose(collateral) * price >= disclose(amount), "undercollateralized");
}

// MS035: setFee() checks the owner, resetFee() changes the same field with no check.
export circuit setFee(f: Uint<64>): [] {
  assert(persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:owner:"), secretKey()]) == ownerHash, "not the owner");
  fee = disclose(f);
}

export circuit resetFee(): [] {
  fee = 0;
}

// MS036: adminId is public, so anyone can pass it as callerId.
export circuit setLimit(callerId: Uint<32>, l: Uint<64>): [] {
  assert(adminId == disclose(callerId), "only the admin");
  limit = disclose(l);
}

// MS037: the prover picks its own rating, so "rating >= threshold" proves nothing.
export circuit proveScoreAbove(threshold: Uint<16>): [] {
  assert(reportedScore() >= threshold, "score too low");
  proofs.increment(1);
}

// MS038: nothing ties claimSecret() to an eligible list, so every new secret is a new nullifier.
export ledger airdropClaimed: Set<Bytes<32>>;
export ledger airdropped: Counter;
witness claimSecret(): Bytes<32>;
export circuit claimAirdrop(): [] {
  const nul = persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:airdrop:"), claimSecret()]);
  assert(!airdropClaimed.member(disclose(nul)), "already claimed");
  airdropClaimed.insert(disclose(nul));
  airdropped.increment(1);
}

// MS015: declared but never used.
witness unusedNonce(): Bytes<32>;
